NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
# 仅本地/内测开启；生产环境请使用部署平台的 Secret 管理
RUNTIME_SETTINGS_ENABLED=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
AUTH_COOKIE_NAME=libtv_session
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
POSTGRES_DB=libtv
POSTGRES_USER=libtv
POSTGRES_PASSWORD=change-me-local
RABBITMQ_DEFAULT_USER=libtv
RABBITMQ_DEFAULT_PASS=change-me-local
DATABASE_URL=postgresql+psycopg://libtv:change-me-local@localhost:5432/libtv
RABBITMQ_URL=amqp://libtv:change-me-local@localhost:5672//
CELERY_TASK_ALWAYS_EAGER=true
DEFAULT_PROVIDER=mock
TEXT_PROVIDER=openai_compatible
TEXT_API_KEY=
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4.1-mini
TEXT_SYSTEM_PROMPT=你是专业的影视创作助手。请直接输出可用于创作流程的中文结果，不要解释你的工作过程。
TEXT_REQUEST_TIMEOUT_SECONDS=90
IMAGE_PROVIDER=openai_compatible
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-2
IMAGE_REQUEST_TIMEOUT_SECONDS=180
IMAGE_WATERMARK=true
LOCAL_VIDEO_BASE_URL=http://127.0.0.1:8787
LOCAL_VIDEO_MODEL=minimax-h3-local
LOCAL_VIDEO_REQUEST_TIMEOUT_SECONDS=1800
LOCAL_VIDEO_POLL_INTERVAL_SECONDS=2
QWEN_API_KEY=
QWEN_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.7-plus
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_IMAGE_MODEL=qwen-image-plus
QWEN_IMAGE_EDIT_MODEL=qwen-image-2.0-pro
QWEN_REQUEST_TIMEOUT_SECONDS=300
QWEN_IMAGE_POLL_INTERVAL_SECONDS=1
AGENT_PROVIDER=qwen
AGENT_MODEL=
AGENT_TEMPERATURE=0.45
AGENT_MAX_TOKENS=2800
AGENT_HISTORY_MESSAGES=20
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=libtv-assets
OBJECT_STORAGE_ACCESS_KEY=libtv
OBJECT_STORAGE_SECRET_KEY=change-me
