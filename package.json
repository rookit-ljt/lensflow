{
  "name": "libtv-web-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @libtv/web dev",
    "build": "pnpm --filter @libtv/workflow-schema build && pnpm --filter @libtv/web build",
    "typecheck": "pnpm -r typecheck",
    "api:setup": "python3 -m venv apps/api/.venv && apps/api/.venv/bin/python -m pip install -e 'apps/api[dev]'",
    "api:dev": "cd apps/api && .venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "api:worker": "cd apps/api && .venv/bin/celery -A app.celery_app:celery_app worker --loglevel=INFO"
  }
}
